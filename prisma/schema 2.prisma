generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model Player {
  id Int @id
  name String
  clubId Int
  team Team @relation(fields:[clubId], references:[id])
  position String
  price Decimal @db.Decimal(5,1)
  status String?
  chanceOfPlaying Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  snapshots PlayerSnapshot[]
  projections PlayerProjection[]
}
model Team { id Int @id; name String; shortName String; players Player[] }
model Gameweek { id Int @id; deadline DateTime?; finished Boolean @default(false); isCurrent Boolean @default(false); isFuture Boolean @default(true); fixtures Fixture[]; projections PlayerProjection[] }
model Fixture { id Int @id; gameweekId Int; homeTeamId Int; awayTeamId Int; kickoff DateTime?; difficultyHome Int?; difficultyAway Int?; gameweek Gameweek @relation(fields:[gameweekId], references:[id]) }
model PlayerSnapshot { id Int @id @default(autoincrement()); playerId Int; capturedAt DateTime @default(now()); totalPoints Int?; form Decimal? @db.Decimal(5,2); minutes Int?; ownership Decimal? @db.Decimal(7,3); transfersIn Int?; transfersOut Int?; price Decimal? @db.Decimal(5,1); player Player @relation(fields:[playerId], references:[id]) }
model PlayerProjection { id Int @id @default(autoincrement()); playerId Int; gameweekId Int; modelVersion String; expectedMinutes Decimal @db.Decimal(6,2); expectedGoals Decimal @db.Decimal(6,3); expectedAssists Decimal @db.Decimal(6,3); cleanSheetProbability Decimal @db.Decimal(6,3); expectedBonus Decimal @db.Decimal(6,3); expectedCardDeduction Decimal @db.Decimal(6,3); expectedPoints Decimal @db.Decimal(7,3); player Player @relation(fields:[playerId], references:[id]); gameweek Gameweek @relation(fields:[gameweekId], references:[id]); @@unique([playerId,gameweekId,modelVersion]) }
model Squad { id String @id; bank Decimal @db.Decimal(5,1); freeTransfers Int @default(1); updatedAt DateTime @updatedAt; players SquadPlayer[] }
model SquadPlayer { squadId String; playerId Int; position String; squad Squad @relation(fields:[squadId], references:[id]); @@id([squadId,playerId]) }
