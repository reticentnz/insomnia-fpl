# Insomnia FPL Environment Configuration

# Database Connection (SQLite)
DATABASE_URL="file:./dev.db"
APP_DATA_DIR="./data"
SIGNAL_INGEST_TOKEN="replace-with-a-long-random-token"
# Optional: when set, Admin page actions require this bearer token.
ADMIN_TOKEN=""
ODDS_API_KEY=""
ODDS_API_REGIONS="uk"
# Optional override for the Understat season start year. Before GW1 the loader
# automatically falls back to the completed prior season when the new one is empty.
UNDERSTAT_SEASON_START_YEAR=""

# Scheduled Ingestion (Hours between background FPL refreshes; set 0 to disable)
FPL_INGEST_INTERVAL_HOURS="12"
FPL_SEASON=""
FPL_SEASON_START_YEAR=""
FPL_INGEST_CACHE_PATH="./data/cache/fpl-official.json"
FPL_CACHE_MAX_AGE_MS="86400000"

# LLM Provider API Keys (Pick one or leave blank for deterministic fallback)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_RESEARCH_MODEL="gpt-5-mini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-20241022"

OLLAMA_HOST="http://localhost:11434"
